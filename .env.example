# ---- Mnemosyne environment ----
# Postgres
POSTGRES_USER=mneme
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=mnemosyne
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend
# 32+ byte random secret for signing JWTs. Generate: openssl rand -hex 32
SECRET_KEY=change_me_to_a_long_random_hex_string
ACCESS_TOKEN_EXPIRE_MINUTES=600
# Where uploaded attachments (content-addressed blobs) live
BLOB_DIR=/data/blobs
MAX_UPLOAD_MB=50
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Cookie flags — set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false

# First admin bootstrap (used by scripts/seed_admin.py)
ADMIN_EMAIL=admin@example.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
